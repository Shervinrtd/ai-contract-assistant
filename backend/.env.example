# Copy this file to `.env` (same folder) and fill in your key. `.env` is gitignored.

# --- Language model -----------------------------------------------------------
# Leave LLM_API_KEY empty to run in mock mode (rule-based, no LLM, clearly labelled).
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
# gpt-6-luna supports tool calling in Chat Completions only with reasoning effort "none".
# Leave empty for providers that do not support this parameter (e.g. Groq, Ollama).
LLM_REASONING_EFFORT=none
# Other OpenAI-compatible providers, for example:
#   Azure / Microsoft Foundry: LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
#   Ollama (local):            LLM_BASE_URL=http://localhost:11434/v1   (any non-empty LLM_API_KEY)
LLM_BASE_URL=

# auto = real model if a key is set, otherwise mock | openai | mock
LLM_MODE=auto

# --- Services (defaults are fine for local development) ------------------------
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
